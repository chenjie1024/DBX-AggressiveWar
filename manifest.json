{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "com.gongfawar.game",
  "name": "AggressiveWar",
  "version": "0.5.0",
  "publisher": "xingxi",
  "description": "在 DBX 里征服了 SQL，为什么不来这里征服世界？27 个国家、随机地图、AI 对手，打开即见。",
  "icon": "assets/icon.svg",
  "source": "https://github.com/chenjie1024/DBX-AggressiveWar",
  "homepage": "https://github.com/chenjie1024/DBX-AggressiveWar",
  "engines": {
    "dbx": ">=0.6.0",
    "host_api": "1"
  },
  "permissions": [
    "host.storage"
  ],
  "entrypoints": {
    "backend": {
      "executable": "bin/dbx-plugin-gongfawar"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "com.gongfawar.game.play",
      "label": "AggressiveWar",
      "description": "区域征服 · 回合制 · 数字兵力。",
      "icon": "assets/icon.svg"
    },
    {
      "type": "command",
      "id": "com.gongfawar.game.open",
      "label": "AggressiveWar",
      "description": "在新的标签页打开攻伐战争。",
      "icon": "assets/icon.svg",
      "action": {
        "type": "open-workbench",
        "workbench": "com.gongfawar.game.play",
        "presentation": "tab",
        "reuse": "singleton"
      }
    },
    {
      "type": "menus",
      "id": "com.gongfawar.game.menus",
      "items": [
        {
          "location": "commandPalette",
          "command": "com.gongfawar.game.open",
          "group": "navigation",
          "order": 60
        },
        {
          "location": "appToolbar",
          "command": "com.gongfawar.game.open",
          "group": "navigation",
          "order": 60,
          "default_visible": false
        }
      ]
    }
  ],
  "localizations": {
    "zh-CN": {
      "name": "AggressiveWar",
      "description": "在 DBX 里征服了 SQL，为什么不来这里征服世界？27 个国家、随机地图、AI 对手，打开即见。",
      "contributions": {
        "com.gongfawar.game.play": {
          "label": "AggressiveWar",
          "description": "区域征服 · 回合制 · 数字兵力。"
        },
        "com.gongfawar.game.open": {
          "label": "AggressiveWar",
          "description": "在新的标签页打开攻伐战争。"
        }
      }
    },
    "en": {
      "name": "AggressiveWar",
      "description": "You've conquered SQL in DBX — why not conquer the world here? 27 nations, procedural maps, AI rivals.",
      "contributions": {
        "com.gongfawar.game.play": {
          "label": "AggressiveWar",
          "description": "Region conquest, turn-based, numeric troops."
        },
        "com.gongfawar.game.open": {
          "label": "AggressiveWar",
          "description": "Open Conquest War in a new tab."
        }
      }
    }
  }
}
